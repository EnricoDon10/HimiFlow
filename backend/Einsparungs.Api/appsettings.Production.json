{
  "Database": {
    "Provider": "SQLite",
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": false
  },
  "Security": {
    "RequireHttps": true,
    "HttpsPort": 443
  },
  "Backup": {
    "AutomaticEnabled": true,
    "IntervalHours": 24,
    "RetentionDays": 30,
    "MinimumBackupsToKeep": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
