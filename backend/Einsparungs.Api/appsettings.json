{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=einsparungen.db"
  },
  "Product": {
    "Name": "HimiFlow Einsparungsdatenbank",
    "Edition": "Local Edition"
  },
  "Legal": {
    "ProviderName": "",
    "LegalForm": "",
    "AddressLines": [],
    "Email": "",
    "Phone": "",
    "Website": "",
    "RegisterCourt": "",
    "RegisterNumber": "",
    "VatId": "",
    "PrivacyContact": ""
  },
  "Database": {
    "Provider": "SQLite",
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "License": {
    "EnforcementEnabled": true,
    "PublicKeyPem": "",
    "InstallationId": "",
    "ClockRollbackToleranceMinutes": 5,
    "ValidationCheckpointIntervalMinutes": 60
  },
  "Backup": {
    "Directory": "backups",
    "AutomaticEnabled": true,
    "IntervalHours": 24,
    "MaximumAgeHours": 36,
    "CheckIntervalMinutes": 15,
    "RetentionDays": 30,
    "MinimumBackupsToKeep": 7
  },
  "Identity": {
    "Password": {
      "RequiredLength": 14,
      "RequiredUniqueChars": 4
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "Minutes": 15
    },
    "Session": {
      "IdleMinutes": 30
    }
  },
  "Security": {
    "RequireHttps": true,
    "HttpsPort": 443,
    "MaxRequestBodySizeBytes": 1048576
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": []
  },
  "Privacy": {
    "MaskKvnrInExports": true
  },
  "Audit": {
    "CleanupEnabled": false,
    "RetentionDays": 0,
    "CheckIntervalHours": 24,
    "BatchSize": 500
  }
}
