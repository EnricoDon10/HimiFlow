    "ValidationCheckpointIntervalMinutes": 60
  },
  "Backup": {
    "Directory": "backups",
    "AutomaticEnabled": true,
    "IntervalHours": 24,
    "MaximumAgeHours": 36,
    "CheckIntervalMinutes": 15,
    "RetentionDays": 30,
    "MinimumBackupsToKeep": 7
  },
  "Identity": {
    "Password": {
      "RequiredLength": 14,
      "RequiredUniqueChars": 4
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "Minutes": 15
    },
    "Session": {
      "IdleMinutes": 30
    }
  },
  "Security": {
    "RequireHttps": true,
    "HttpsPort": 443,
    "MaxRequestBodySizeBytes": 1048576
  },
  "DataProtection": {
    "KeyRingPath": ""
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": []
  },
  "Privacy": {
    "MaskKvnrInExports": true
  },
  "Exports": {
    "MaximumRows": 10000
  },
  "Audit": {
    "CleanupEnabled": false,
    "RetentionDays": 0,
    "CheckIntervalHours": 24,
    "BatchSize": 500
  }
