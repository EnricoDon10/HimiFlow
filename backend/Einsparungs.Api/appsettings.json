{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=einsparungen.db"
  },
  "Database": {
    "Provider": "SQLite",
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "License": {
    "EnforcementEnabled": true,
    "PublicKeyPem": "",
    "InstallationId": ""
  },
  "Backup": {
    "Directory": "backups"
  },
  "Privacy": {
    "MaskKvnrInExports": true
  },
  "Audit": {
    "RetentionDays": 0
  }
}
